# alvarocdev — public build-time env (Astro exposes only PUBLIC_* to the client).
# Copy to `.env` to enable. Everything here is OFF by default: with these unset the
# site ships zero JavaScript, no cookies and no external requests, exactly as today.

# --- Nexo beacon emitter (M5) ---------------------------------------------------
# Opt-in, cookieless page-view beacon for the nexotools /admin dashboard. When
# enabled, each page emits a single navigator.sendBeacon() with {origin:'alvarocdev',
# path, event:'pageview'} (plus the referring tool host if the visit came from an
# ecosystem subdomain). It respects Do Not Track and sends no cookies, IP or UA.
# Contract: nexotools inbox/brand-unification/M5-spec.md (AC-BEACON-8).

# Turn the emitter on ("true" to enable; anything else, or unset, keeps it OFF).
PUBLIC_NEXO_BEACON_ENABLED=false

# Base URL of the Nexo hub that ingests beacons. Required when enabled; the emitter
# POSTs to <hub>/beacon. No trailing slash needed.
PUBLIC_NEXO_HUB_URL=https://nexotools.alvarocdev.com
