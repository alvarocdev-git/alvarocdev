---
import { site, type Locale } from '../i18n/translations';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const canonical = new URL(site.localePaths[lang], Astro.site);

// OG image absoluta (marca personal: card oscura + acento verde, 1200×630).
const ogImage = new URL('/og-image.png', Astro.site);
// og:locale en formato idioma_TERRITORIO por idioma, con el resto como alternates.
const ogLocales: Record<Locale, string> = { es: 'es_ES', en: 'en_US', pt: 'pt_BR' };
const ogLocaleAlternates = (Object.keys(ogLocales) as Locale[])
  .filter((code) => code !== lang)
  .map((code) => ogLocales[code]);

// Beacon emisor (M5): opt-in, cookieless, respeta Do Not Track. Env-gated y OFF
// por default: si no está habilitado, no se emite NINGÚN <script> (el sitio sigue
// enviando cero JS). Ver AGENTS.md y .env.example.
const beaconEnabled =
  import.meta.env.PUBLIC_NEXO_BEACON_ENABLED === 'true' && !!import.meta.env.PUBLIC_NEXO_HUB_URL;
const beaconHub = (import.meta.env.PUBLIC_NEXO_HUB_URL ?? '').replace(/\/+$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0f14" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      (Object.entries(site.localePaths) as [Locale, string][]).map(([code, path]) => (
        <link rel="alternate" hreflang={code} href={new URL(path, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="alvarocdev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="alvarocdev.com — Alvaro Carrizales, Backend Tech Lead en Buenos Aires" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {ogLocaleAlternates.map((code) => <meta property="og:locale:alternate" content={code} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="alvarocdev.com — Alvaro Carrizales, Backend Tech Lead en Buenos Aires" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    {
      beaconEnabled && (
        <script is:inline define:vars={{ beaconHub }}>
          (function () {
            try {
              var dnt =
                navigator.doNotTrack === '1' ||
                window.doNotTrack === '1' ||
                navigator.msDoNotTrack === '1';
              if (dnt || !navigator.sendBeacon) return;
              var payload = { origin: 'alvarocdev', path: location.pathname, event: 'pageview' };
              // Si el visitante llega desde una tool del ecosistema, incluir de cuál
              // (para la vista "de qué tool llegaron" del /admin de nexotools).
              if (document.referrer) {
                try {
                  var host = new URL(document.referrer).hostname;
                  if (/(^|\.)nexo(id|links|agenda|short|events|tools)\.alvarocdev\.com$/.test(host)) {
                    payload.ref = host;
                  }
                } catch (e) {}
              }
              navigator.sendBeacon(beaconHub + '/beacon', JSON.stringify(payload));
            } catch (e) {}
          })();
        </script>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0f14;
    --bg-raise: #10161e;
    --border: #1e2a36;
    --text: #e6edf3;
    --muted: #8b98a5;
    /* Acento personal de Alvaro (marca alvarocdev). */
    --accent: #4ade80;
    --accent-dim: rgba(74, 222, 128, 0.12);
    /* Acento del ecosistema Nexo (violeta): misma arquitectura de tokens que la
       marca personal, distinto color. Solo se usa en la sección del ecosistema. */
    --eco: #a78bfa;
    --eco-strong: #8b5cf6;
    --eco-dim: rgba(139, 92, 246, 0.14);
    /* Stack tipográfico de sistema compartido con el ecosistema Nexo (sin CDNs). */
    --font-sans:
      ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
      sans-serif;
    --font-mono:
      ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
