---
import Base from '../layouts/Base.astro';
import { translations, site, type Locale } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const stack = ['PHP', 'Laravel', 'MySQL', 'Docker', 'Kubernetes', 'AWS', 'REST APIs'];
const year = new Date().getFullYear();

// Cambiar a true cuando estén listos los casos de estudio de clientes
// (completar antes los datos en t.work.clients de src/i18n/translations.ts).
const showClientWork = false;

// Andamiaje del carrusel de clientes: si no hay clientes reales cargados,
// se muestran tarjetas placeholder para conservar el patrón visual.
const clients = t.work.clients;
const clientPlaceholders = [1, 2, 3];
const hasCaseStudies = clients.some((c) => c.problem || c.solution || c.outcome);
---

<Base lang={lang} title={t.metaTitle} description={t.metaDescription}>
  <a class="skip-link" href="#contenido">{t.nav.skip}</a>

  <header class="topbar">
    <nav class="container topbar-inner" aria-label="main">
      <a href={site.localePaths[lang]} class="brand">alvarocdev<span class="cursor">_</span></a>
      <div class="nav-links">
        <a href="#sobre-mi">{t.nav.about}</a>
        <a href="#productos">{t.nav.products}</a>
        {showClientWork && <a href="#clientes">{t.nav.work}</a>}
        <a href="#contacto">{t.nav.contact}</a>
      </div>
      <div class="lang-switch" aria-label="language">
        {
          (Object.entries(site.localePaths) as [Locale, string][]).map(([code, path]) => (
            <a href={path} class:list={[{ active: code === lang }]} aria-current={code === lang ? 'page' : undefined}>
              {code}
            </a>
          ))
        }
      </div>
    </nav>
  </header>

  <main class="container" id="contenido">
    {/*
      The hero extends the one genuinely terminal gesture this site already
      has — the wordmark's blinking cursor — instead of the kicker + "Hola,
      soy" + two-button row every portfolio ships. One prompt and its answer:
      who is typing. Then the claim. No fake window chrome, no JS; the
      ecosystem gets its own section instead of a status line up here.
    */}
    <section class="hero">
      <p class="prompt-line">
        <span class="prompt-sign" aria-hidden="true">~ $</span> {t.hero.prompt}<span class="cursor">_</span>
      </p>
      <p class="prompt-out">{t.hero.role}</p>

      <h1>{t.hero.title}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
    </section>

    <section id="sobre-mi">
      <h2>{t.about.title}</h2>
      {t.about.paragraphs.map((p) => <p class="prose">{p}</p>)}
      <div class="facts">
        <div>
          <p class="fact-label">{t.about.stackLabel}</p>
          <ul class="tags">
            {stack.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <p class="fact-label">{t.about.languagesLabel}</p>
          <p class="fact-value">{t.about.languages}</p>
        </div>
      </div>
    </section>

    {/*
      The one eyebrow left on the page. It stays because it is the only one
      that says something the h2 does not: rendered in --eco, it is where the
      personal green hands over to the ecosystem's violet. The other three
      repeated their own heading in mono and were pure rhythm.
    */}
    <section id="productos" class="ecosystem">
      <p class="section-label">// {t.products.label}</p>
      <h2>{t.products.title}</h2>
      <div class="eco-intro">
        <img class="eco-badge" src="/ecosystem/nexo.svg" alt="Nexo" width="32" height="32" decoding="async" />
        <p class="prose">{t.products.intro}</p>
      </div>
      <p class="prose muted eco-opensource">{t.products.openSource}</p>

      <div class="cards eco-cards">
        {
          t.products.items.map((item) => (
            <article class="card eco-card">
              <div class="eco-card-head">
                <img
                  class="mark"
                  src={`/ecosystem/${item.key}.svg`}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                />
                <div class="eco-card-title">
                  <h3>{item.name}</h3>
                  <span class:list={['status', item.status === 'live' ? 'status-live' : 'status-soon']}>
                    {item.status === 'live' ? t.products.statusLive : t.products.statusSoon}
                  </span>
                </div>
              </div>
              <p>{item.description}</p>
              <ul class="tags">
                {item.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <div class="card-actions">
                {item.demo && (
                  <a class="card-link primary" href={item.demo} target="_blank" rel="noopener noreferrer">
                    {t.products.viewDemo} →
                  </a>
                )}
                <a class="card-link" href={site.nexoGithubOrg} target="_blank" rel="noopener noreferrer">
                  {t.products.viewCode}
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <a class="eco-org-link" href={site.nexoGithubOrg} target="_blank" rel="noopener noreferrer">
        {t.products.browseOrg} →
      </a>
    </section>

    {showClientWork && (
    <section id="clientes">
      <h2>{t.work.title}</h2>
      <p class="prose muted">{t.work.intro}</p>

      {/*
        Carrusel de clientes: fila desplazable en horizontal; cada tarjeta
        enlaza directo al sitio público del cliente. Los datos reales van en
        t.work.clients (hoy vacío). No inventar clientes: mientras esté vacío
        se muestran placeholders para conservar el patrón.
      */}
      <div class="carousel" role="list" aria-label={t.work.title}>
        {
          clients.length
            ? clients.map((client) => (
                <a
                  class="card client-card"
                  href={client.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  role="listitem"
                >
                  <div class="card-head">
                    <h3>{client.name}</h3>
                    <span class="visit-hint">{t.work.visitSite} ↗</span>
                  </div>
                  <p>{client.tagline}</p>
                </a>
              ))
            : clientPlaceholders.map(() => (
                <article class="card client-card card-placeholder" role="listitem">
                  <div class="card-head">
                    <h3>{t.work.placeholderTitle}</h3>
                  </div>
                  <p>{t.work.placeholderText}</p>
                </article>
              ))
        }
      </div>

      {/*
        Vista de info opcional: una sola sección desplegable (native <details>,
        sin JS) con los casos de estudio detallados. Solo aparece cuando algún
        cliente real trae problema/solución/resultado.
      */}
      {hasCaseStudies ? (
        <details class="case-studies">
          <summary>{t.work.caseStudies}</summary>
          {clients
            .filter((c) => c.problem || c.solution || c.outcome)
            .map((client) => (
              <article class="case-study">
                <h3>{client.name}</h3>
                {client.problem && <p>{client.problem}</p>}
                {client.solution && <p>{client.solution}</p>}
                {client.outcome && <p>{client.outcome}</p>}
              </article>
            ))}
        </details>
      ) : (
        <p class="prose muted case-empty">{t.work.emptyState}</p>
      )}
    </section>
    )}

    <section id="contacto">
      <h2>{t.contact.title}</h2>
      <p class="prose">{t.contact.text}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>{t.contact.emailCta}</a>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <p class="email-plain"><code>{site.email}</code></p>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <p>© {year} Alvaro Carrizales · alvarocdev</p>
      <p class="muted">{t.footer.madeWith}</p>
    </div>
  </footer>
</Base>

<style>
  .container {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* --- top bar --- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 3.75rem;
  }

  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text);
    font-size: 1rem;
  }

  .brand:hover {
    text-decoration: none;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
    html {
      scroll-behavior: auto;
    }
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .nav-links a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .lang-switch {
    display: flex;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .lang-switch a {
    color: var(--muted);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .lang-switch a.active {
    color: var(--accent);
    background: var(--accent-dim);
  }

  .lang-switch a:hover {
    text-decoration: none;
    color: var(--text);
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
    .lang-switch {
      margin-left: auto;
    }
  }

  /* --- sections ------------------------------------------------------------
     Uneven on purpose. Every band at 4.5rem read as a template: the page had
     one rhythm and nothing to say about which part mattered. Now the hero
     opens with air and closes tight against the first answer, the ecosystem
     — the centrepiece — gets the widest band, and contact sits close to what
     precedes it because it is the end of a conversation, not a new topic. */
  section {
    padding: 4.5rem 0 1rem;
  }

  .hero {
    padding: 6rem 0 1.5rem;
  }

  #sobre-mi {
    padding: 3rem 0 1rem;
  }

  .ecosystem {
    padding: 5.5rem 0 1.5rem;
  }

  #clientes {
    padding: 4rem 0 1rem;
  }

  #contacto {
    padding: 3.25rem 0 1rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3.5rem 0 1.25rem;
    }

    #sobre-mi {
      padding: 2.25rem 0 1rem;
    }

    .ecosystem {
      padding: 3.75rem 0 1.25rem;
    }

    #clientes,
    #contacto {
      padding: 2.5rem 0 1rem;
    }
  }

  /* --- hero: the wordmark's terminal gesture, extended ---------------------
     A prompt line and its answer, twice. Deliberately not a drawn terminal:
     no window frame, no traffic lights — just the mono face, the accent on
     the sign, and the same cursor animation the wordmark uses. */
  .prompt-line {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }

  .prompt-sign {
    color: var(--accent);
    user-select: none;
  }

  .prompt-out {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .prompt-line + .prompt-out {
    /* Sits under the command, indented to the width of "~ $ " so the answer
       reads as output rather than as another line of prose. */
    padding-left: 2.2ch;
  }

  h1 {
    font-size: clamp(2.1rem, 6vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 34em;
    margin-bottom: 2rem;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  .prose {
    margin-bottom: 1rem;
    /* ~68ch at the body size: 40em ran to ~78ch, past the comfortable ceiling. */
    max-width: 34em;
  }

  .muted {
    color: var(--muted);
  }

  /* --- about facts --- */
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .fact-value {
    font-size: 0.95rem;
  }

  /* --- cards --- */
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card p {
    color: var(--muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card h3 {
    font-size: 1.15rem;
  }

  .status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
    white-space: nowrap;
  }

  .card-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .card-placeholder {
    border-style: dashed;
  }

  .card-placeholder:hover {
    border-color: var(--border);
  }

  .card-placeholder h3 {
    color: var(--muted);
  }

  /* --- ecosystem (Nexo — acento violeta dentro del portafolio personal) ---
     Los tokens --eco* viven en :root (Base.astro); acá solo se consumen, de modo
     que el violeta es la señal de marca del ecosistema y el verde sigue siendo el
     acento personal en el resto del sitio. */
  .ecosystem .section-label {
    color: var(--eco);
  }

  .eco-intro {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .eco-badge {
    flex-shrink: 0;
    border-radius: 8px;
    margin-top: 0.15rem;
  }

  .eco-opensource {
    padding-left: calc(32px + 0.85rem);
    margin-top: -0.25rem;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .eco-opensource {
      padding-left: 0;
    }
  }

  .eco-card:hover {
    border-color: var(--eco-strong);
  }

  .eco-card-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .mark {
    flex-shrink: 0;
    border-radius: 10px;
    display: block;
  }

  .eco-card-title {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .eco-card-title h3 {
    line-height: 1.2;
  }

  .status-live {
    color: var(--eco);
    background: var(--eco-dim);
    align-self: flex-start;
  }

  .status-soon {
    color: var(--muted);
    background: color-mix(in srgb, var(--muted) 14%, transparent);
    align-self: flex-start;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: auto;
  }

  .card-link.primary {
    color: var(--eco);
    font-weight: 600;
  }

  .eco-org-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--eco);
  }

  /* --- tags --- */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
  }

  /* --- client carousel (scaffold, currently hidden) --- */
  .carousel {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-bottom: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .carousel .card {
    flex: 0 0 clamp(240px, 72vw, 300px);
    scroll-snap-align: start;
  }

  .client-card {
    color: var(--text);
  }

  a.client-card:hover {
    text-decoration: none;
    border-color: var(--accent);
  }

  .visit-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .case-studies {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-raise);
    padding: 0 1.5rem;
  }

  .case-studies summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 1rem 0;
    color: var(--accent);
  }

  .case-study {
    padding: 0.5rem 0 1.25rem;
    border-top: 1px solid var(--border);
  }

  .case-study h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .case-study p {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .case-empty {
    margin-top: 1.25rem;
    font-size: 0.9rem;
  }

  /* --- buttons --- */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    transition:
      border-color 0.2s cubic-bezier(0.2, 0, 0.2, 1),
      background 0.2s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .btn:hover {
    text-decoration: none;
    border-color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  .btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 85%, white);
  }

  .email-plain {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .email-plain code {
    font-family: var(--font-mono);
  }

  /* --- footer --- */
  footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    font-size: 0.85rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
